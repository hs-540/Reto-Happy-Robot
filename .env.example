# Copia este archivo a la raíz del repositorio como `.env` y rellena los valores.
# El backend carga `.env` desde la raíz del repo al arrancar; `.env` está fuera del
# control de versiones y nunca debe subirse a git.

# Puerto HTTP del backend
PORT=3001

# Cadencia del motor de decisión en ms (diseño: tick cada 5-10 s)
TICK_MS=5000

# ── Proveedor LLM: Helmcode (interfaz OpenAI-compatible) ──────────────
# El proveedor es configuración, no código: cambiarlo es editar estas
# variables, sin tocar `config.ts`. Si el proveedor cae, el motor degrada
# al fallback determinista de reglas y la simulación no se detiene.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Modelo de embeddings del RAG, vía el mismo proveedor
LLM_EMBEDDING_MODEL=text-embedding-3-small

# Etiqueta del proveedor; solo aparece en los logs
LLM_PROVIDER=helmcode

# ── HappyRobot: llamadas de voz y mensajes reales ─────────────────────
HAPPYROBOT_API_KEY=

# ── RAG local (Chroma) ────────────────────────────────────────────────
# Puerto del servidor Chroma local. Si ya hay uno en ese puerto se reutiliza.
CHROMA_PORT=8000

# Datos locales de Chroma, ruta relativa a la raíz del repo
CHROMA_PATH=backend/chroma-data
