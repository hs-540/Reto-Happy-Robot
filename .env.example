# Copia este archivo a la raíz del repositorio como `.env` y rellena los valores.
# El backend carga `.env` desde la raíz del repo al arrancar; `.env` está fuera del
# control de versiones y nunca debe subirse a git.

# Puerto HTTP del backend
PORT=3001

# Cadencia del motor de decisión en ms (diseño: tick cada 5-10 s)
TICK_MS=5000

# LLM principal — Vercel AI Gateway (interfaz OpenAI-compatible)
VERCEL_AI_GATEWAY_URL=
VERCEL_AI_GATEWAY_API_KEY=
VERCEL_AI_GATEWAY_MODEL=

# LLM de respaldo — Cloudflare AI Gateway (interfaz OpenAI-compatible)
CLOUDFLARE_AI_GATEWAY_URL=
CLOUDFLARE_AI_GATEWAY_API_KEY=
CLOUDFLARE_AI_GATEWAY_MODEL=

# Credenciales HappyRobot (llamadas de voz y mensajes reales)
HAPPYROBOT_API_KEY=

# Datos locales de Chroma (RAG), relativos a la raíz del repo
CHROMA_PATH=backend/chroma-data
