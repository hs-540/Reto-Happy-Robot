# Copy this file to the repository root as `.env` and fill in the values.
# The backend loads `.env` from the repo root on startup; `.env` is outside
# version control and must never be committed to git.
#
# Every variable without a default here is required: `config.ts` validates the
# whole file on boot and exits listing what failed (never the value). An empty
# string counts as missing.

# HTTP port of the backend
PORT=3001

# Decision engine cadence in ms. Keep this at a couple of seconds: each idle
# tick otherwise lets a chunk of crisis pass between sensor updates.
TICK_MS=2000

# Crisis seconds per real second: how fast the simulated clock runs.
# 15x compresses 30 crisis-minutes into ~2 real minutes and every limit in
# rules.json comes due fast; 6x keeps a 15-48 s LLM deliberation inside
# 3-5 crisis-minutes, so decisions land while the situation can still be saved.
TIME_SCALE=15

# ── LLM provider: Helmcode (OpenAI-compatible interface) ─────────────
# The provider is configuration, not code: switching it means editing these
# variables, without touching `config.ts`. If the provider goes down, the
# engine degrades to the deterministic rules fallback and the simulation
# does not stop.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Embedding model for the RAG, via the same provider
LLM_EMBEDDING_MODEL=text-embedding-3-small

# Provider label; only shows up in logs
LLM_PROVIDER=helmcode

# ── HappyRobot: real voice calls ─────────────────────────────────────
# The agent dispatches every outbound call to a HappyRobot mission hook with
# `{ "prompt": ..., "missionId": ... }`: no phone number travels, the mission
# knows who it calls.
#
# Leave HAPPYROBOT_WEBHOOK_URL unset (or empty) to run with the SIMULATED
# client: the same chain is exercised with scripted answers and the demo stands
# up. Set it to the full hook URL to place real calls.
#HAPPYROBOT_WEBHOOK_URL=

# Key of the hook, sent as `x-api-key` on every dispatch. A webhook trigger
# guarded on the HappyRobot side rejects any request without it; leave this
# empty for an unguarded hook and no header is sent.
HAPPYROBOT_API_KEY=

# Outbound call queue between the agent and the HappyRobot client: one phone
# line by default. While a call is in flight the rest wait in the queue; when a
# slot frees, the most urgent pending call is dialled.
HAPPYROBOT_MAX_CONCURRENT_CALLS=1
HAPPYROBOT_MAX_QUEUED_CALLS=3
# Backstop: a slot held with no closure for this long is released and the call
# closes as no_answer, so a lost webhook cannot deadlock the queue
HAPPYROBOT_CALL_SLOT_TIMEOUT_MS=120000

# ── Events API: the return path of a real call ───────────────────────
# When the voice agent hangs up, the hook posts a call-summary event to this
# worker and the backend polls it every EVENTS_POLL_MS, matching each summary
# by missionId to close the call. Without a key the poll is off and real calls
# only close through the slot backstop above.
EVENTS_API_URL=https://events-api.hs540events.workers.dev
EVENTS_API_KEY=
EVENTS_POLL_MS=10000

# ── Local RAG (Chroma) ───────────────────────────────────────────────
# Port of the local Chroma server. If one is already on that port it gets reused.
CHROMA_PORT=8000

# Chroma local data, path relative to the repo root
CHROMA_PATH=backend/chroma-data
