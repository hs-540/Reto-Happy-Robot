# Copy this file to the repository root as `.env` and fill in the values.
# The backend loads `.env` from the repo root on startup; `.env` is outside
# version control and must never be committed to git.

# HTTP port of the backend
PORT=3001

# Decision engine cadence in ms (design: tick every 5-10 s)
TICK_MS=5000

# ── LLM provider: Helmcode (OpenAI-compatible interface) ─────────────
# The provider is configuration, not code: switching it means editing these
# variables, without touching `config.ts`. If the provider goes down, the
# engine degrades to the deterministic rules fallback and the simulation
# does not stop.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Embedding model for the RAG, via the same provider
LLM_EMBEDDING_MODEL=text-embedding-3-small

# Provider label; only shows up in logs
LLM_PROVIDER=helmcode

# ── HappyRobot: real voice calls and messages ────────────────────────
HAPPYROBOT_BASE_URL=https://app.happyrobot.ai
HAPPYROBOT_API_KEY=

# ── Local RAG (Chroma) ───────────────────────────────────────────────
# Port of the local Chroma server. If one is already on that port it gets reused.
CHROMA_PORT=8000

# Chroma local data, path relative to the repo root
CHROMA_PATH=backend/chroma-data
